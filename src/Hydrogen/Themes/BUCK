# Hydrogen.Themes — the Radix Themes (radix-ui/themes) STYLED system, ported to
# Halogen on top of the unstyled Radix primitives. `Prop` is the shared prop→class
# engine (a typed port of upstream's extractProps); Layout/Button/… emit the exact
# `rt-*` class + `data-*` vocabulary, so radix's own compiled `styles.css` renders
# them pixel-identically. Diffed against the golden source in testing/golden/themes.
purescript_library(
    name = "themes",
    srcs = [
        "AccessibleIcon.purs",
        "AspectRatio.purs",
        "Avatar.purs",
        "Badge.purs",
        "Blockquote.purs",
        "Button.purs",
        "Callout.purs",
        "Card.purs",
        "Checkbox.purs",
        "CheckboxCards.purs",
        "CheckboxGroup.purs",
        "Code.purs",
        "Container.purs",
        "DataList.purs",
        "Dialog.purs",
        "Grid.purs",
        "IconButton.purs",
        "Inline.purs",
        "Inset.purs",
        "Kbd.purs",
        "Layout.purs",
        "Link.purs",
        "Portal.js",
        "Portal.purs",
        "Progress.purs",
        "Prop.purs",
        "Quote.purs",
        "RadioCards.purs",
        "RadioGroup.purs",
        "Section.purs",
        "SegmentedControl.purs",
        "Separator.purs",
        "Skeleton.purs",
        "Slider.purs",
        "Spinner.purs",
        "Switch.purs",
        "Table.purs",
        "TabNav.purs",
        "Tabs.purs",
        "TextArea.purs",
        "TextField.purs",
        "Theme.purs",
        "Typography.purs",
        "VisuallyHidden.purs",
    ],
    visibility = ["PUBLIC"],
)
