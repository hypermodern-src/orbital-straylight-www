# orbital-web-jw — downstream straylight-prelude Buck2 project.

[cells]
root = .
prelude = nix/build/prelude
straylight_prelude = prelude
toolchains = nix/build/toolchains
hydrogen = nix/build/hydrogen
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
fbcode_macros = none
buck = none

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default

[buck2]
materializations = deferred
digest_algorithms = BLAKE3

[build]
execution_platforms = toolchains//:local
