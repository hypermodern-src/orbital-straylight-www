# hydrogen self-typecheck (cached, buck2). SEPARATE package so the root BUCK that
# straylight-web consumes (hydrogen//:lib, via the old pinned prelude) stays free
# of the `packages` kwarg. Pulls hydrogen's source via deps=["//:lib"] (purs
# _compile globs its src/**/*.purs + adjacent FFI .js), compiles it against the
# registry closure (//:registry.bzl, shared with examples/ — a proven superset at
# registry 73.2.0, content-addressed/sha256-pinned). The straylight-prelude
# purescript_library `packages=` emits a `<name>_check` purs_compile target.
#   nix develop -c buck2 build //check:hydrogen_check   ->  typecheck, cached
load("//:registry.bzl", "PURS_REGISTRY")

purescript_library(
    name = "hydrogen",
    srcs = [],
    deps = ["//:lib"],
    packages = PURS_REGISTRY,
)
