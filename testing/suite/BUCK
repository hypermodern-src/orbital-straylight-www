# The hydrogen test suite — a purescript_test (prelude): compile the suite + the
# assertion harness + the library under test + the registry closure, run Test.Main
# under node, and report pass/fail by exit code to `buck2 test`.
#   buck2 test //testing/suite:test    (or `buck2 test //...`)
load("//:registry.bzl", "PURS_REGISTRY")

purescript_test(
    name = "test",
    srcs = [
        "Test/Color.purs",
        "Test/Compute.purs",
        "Test/Format.purs",
        "Test/Main.purs",
        "Test/RemoteData.purs",
        "Test/Router.purs",
        "Test/Style.purs",
    ],
    main = "Test.Main",
    deps = [
        "//:lib",
        "//testing/support:assert",
    ],
    packages = PURS_REGISTRY,
    visibility = ["PUBLIC"],
)
