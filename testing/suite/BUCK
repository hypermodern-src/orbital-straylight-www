        "Test/Compute.purs",
        "Test/Format.purs",
        "Test/Main.purs",
        "Test/Prop/Compute.purs",
        "Test/Prop/Format.purs",
        "Test/Prop/RemoteData.purs",
        "Test/Prop/Router.purs",
        "Test/Prop/Style.purs",
