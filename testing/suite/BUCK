# The hydrogen test suite — a purescript_test (prelude): compile the suite + the
# assertion/property harness + the library under test + the registry+QuickCheck
# closure, run Test.Main under node, report pass/fail by exit code to `buck2 test`.
#   buck2 test //testing/suite:test    (or `buck2 test //...`)
load("//:registry.bzl", "PURS_REGISTRY_TEST")

purescript_test(
    name = "test",
    srcs = [
