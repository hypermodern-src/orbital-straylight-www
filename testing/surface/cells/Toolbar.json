    { "id": "toolbar.disabled", "state": "disabled", "importance": "common", "status": "gated", "oracle": ["dom"],         "ref": "disabled button: disabled attr + excluded from roving order" },
    { "id": "toolbar.rest",     "state": "rest",     "importance": "common", "status": "gated", "oracle": ["aria"],        "ref": "at-rest a11y tree (toolbar>button/link/separator/group>radio)" },

    { "id": "toolbar.toggle-click",   "state": "open", "importance": "core",   "status": "open", "oracle": ["dom"],        "ref": "toolbar.tsx:200-212 click toggle item flips data-state/aria-checked, single-mode radio moves; golden only at-rest" },
    { "id": "toolbar.group-cross",    "state": "open", "importance": "core",   "status": "open", "oracle": ["apg"],        "ref": "toolbar.tsx:176-183 inner ToggleGroup rovingFocus=false; arrow must CROSS group boundary as one continuous 4-item roving order" },
    { "id": "toolbar.link-space",     "state": "open", "importance": "common", "status": "open", "oracle": ["apg"],        "ref": "toolbar.tsx:142-145 ToolbarLink Space synthesizes click (native <a> ignores); no oracle drives Space on link" },
    { "id": "toolbar.noloop",         "state": "open", "importance": "common", "status": "open", "oracle": ["apg"],        "ref": "toolbar.tsx:46 loop=false end-stop + loop=true wrap-around; neither exercised" },
    { "id": "toolbar.rtl",            "state": "open", "importance": "common", "status": "open", "oracle": ["dom", "apg"], "ref": "toolbar.tsx:48,55,61 dir=rtl flips horizontal arrows; no rtl story" },
    { "id": "toolbar.disabled-skip",  "state": "open", "importance": "common", "status": "open", "oracle": ["dom", "apg"], "ref": "toolbar.tsx:114 disabled button non-focusable, excluded from roving; ArrowRight skips it" },
    { "id": "toolbar.multiple",       "state": "open", "importance": "common", "status": "open", "oracle": ["dom", "aria"], "ref": "toolbar.tsx:161-162 ToggleGroup type=multiple: aria-pressed multi-select; every story is single" },
    { "id": "toolbar.shift-tab-out",  "state": "open", "importance": "common", "status": "open", "oracle": ["apg"],        "ref": "roving-focus-group.tsx:262-265 Shift+Tab tabs OUT (isTabbingBackOut); port has no shift-tab handling" },

    { "id": "toolbar.page-keys",      "state": "open", "importance": "edge", "status": "open", "oracle": ["apg"], "ref": "edge: PageUp→first / PageDown→last navigation" },
    { "id": "toolbar.entry-priority", "state": "open", "importance": "edge", "status": "open", "oracle": ["apg"], "ref": "edge: onEntryFocus candidate priority (active→currentTabStop→DOM order)" },
    { "id": "toolbar.prevent-scroll", "state": "open", "importance": "edge", "status": "open", "oracle": ["none"],"ref": "edge: preventScrollOnEntryFocus / focus({preventScroll})" },
    { "id": "toolbar.prop-passthru",  "state": "open", "importance": "edge", "status": "open", "oracle": ["dom"], "ref": "edge: arbitrary Primitive.div prop passthrough (className etc.)" },
    { "id": "toolbar.aschild",        "state": "open", "importance": "edge", "status": "open", "oracle": ["dom"], "ref": "edge: asChild composition on every part (root, Button, Link)" },
    { "id": "toolbar.separator-role", "state": "open", "importance": "edge", "status": "open", "oracle": ["aria"],"ref": "edge: Separator non-decorative (role=separator, aria-orientation)" }
