  "cells": [
    { "id": "toolbar.default",  "state": "default",  "importance": "core",   "status": "gated", "oracle": ["dom", "aria"], "ref": "root role=toolbar + aria-orientation + tabindex=0; button/link/separator/nested toggle-group at rest" },
    { "id": "toolbar.vertical", "state": "vertical", "importance": "common", "status": "gated", "oracle": ["dom"],         "ref": "orientation=vertical: data-orientation, flipped separator orientation" },
