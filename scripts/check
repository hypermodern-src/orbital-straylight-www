#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

check_hydrogen() {
  nix flake check --accept-flake-config "$repo_root/projects/hydrogen"
}

check_reinit_dx() {
  nix flake check --accept-flake-config "$repo_root/projects/reinit-dx"
}

check_hypermodern_consulting() {
  (
    cd "$repo_root/projects/hypermodern-consulting"
    bun install --frozen-lockfile
    bun run build
  )
}

check_straylight_web() {
  nix flake check --accept-flake-config "$repo_root/projects/straylight-web"
}

check_orbital_web_jw() {
  nix flake check --accept-flake-config "$repo_root/projects/orbital-web-jw"
}

check_web_middleware() {
  nix flake check --accept-flake-config "$repo_root/projects/web-middleware"
}

check_orbital_cms() {
  nix flake check --accept-flake-config "$repo_root/projects/orbital-cms"
}

check_orbital_forge() {
  nix flake check --accept-flake-config "$repo_root/projects/orbital-forge"
}

check_ponce_speedway() {
  nix flake check --accept-flake-config "$repo_root/projects/ponce-speedway"
}

check_one() {
  case "$1" in
    hydrogen) check_hydrogen ;;
    reinit-dx) check_reinit_dx ;;
    hypermodern-consulting) check_hypermodern_consulting ;;
    straylight-web) check_straylight_web ;;
    orbital-web-jw) check_orbital_web_jw ;;
    web-middleware) check_web_middleware ;;
    orbital-cms) check_orbital_cms ;;
    orbital-forge) check_orbital_forge ;;
    ponce-speedway) check_ponce_speedway ;;
    *)
      printf 'unknown project: %s\n' "$1" >&2
      exit 2
      ;;
  esac
}

if (($#)); then
  for project in "$@"; do
    check_one "$project"
  done
else
  check_one hydrogen
  check_one reinit-dx
  check_one hypermodern-consulting
  check_one straylight-web
  check_one orbital-web-jw
  check_one web-middleware
  check_one orbital-cms
  check_one orbital-forge
  check_one ponce-speedway
fi
