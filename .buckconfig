# reinit-dx — downstream straylight-prelude buck2 project.
#
# The prelude + toolchains cells are the generated straylight-prelude package;
# the hydrogen cell is the pinned hydrogen flake input. All three are symlinked
# into nix/build/ by the project mechanism (build phase + devshell). Toolchain
# paths live in .buckconfig.local (generated).

[cells]
root = .
prelude = nix/build/prelude
straylight_prelude = prelude
toolchains = nix/build/toolchains
# hydrogen as a first-class library cell (STR-234): consumed as hydrogen//:lib.
hydrogen = nix/build/hydrogen
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
fbcode_macros = none
buck = none

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default

[buck2]
materializations = deferred
digest_algorithms = BLAKE3

[build]
execution_platforms = toolchains//:local
