# Live demo of the stateful Hydrogen.Themes.Dialog — the Bucket B (overlay/portal)
# reference component. A real Halogen app (open/close state, document Escape
# listener, backdrop-click, scroll-lock, focus) bundled to the browser; its DOM
# mirrors upstream rt-Dialog*. The interaction harness
# (testing/playwright/dialog-interaction.mjs) drives the behaviour.
#   nix develop -c buck2 build //examples/dialog:app
load("//:registry.bzl", "PURS_REGISTRY")

purescript_app(
    name = "app",
    srcs = [
        "src/DialogExample/Main.purs",
    ],
    main = "DialogExample.Main",
    deps = ["//:lib"],
    index_html = "index.html",
    style_css = "themes.css",
    packages = PURS_REGISTRY,
)
