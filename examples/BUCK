        "src/Gallery/Story/InvF.purs",
        "src/Gallery/Story/OvlDialog.purs",
    ],
    main = "Gallery.Main",
    deps = ["//:lib"],
    index_html = "index.html",
    style_css = "gallery.css",
    packages = PURS_REGISTRY,
)
