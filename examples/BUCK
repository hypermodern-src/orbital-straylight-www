# Hydrogen.Radix gallery — reproductions of radix-ui's Storybook (MIT, (c) WorkOS)
# rendered with the ported Halogen primitives, bundled to a browser app for
# pixel-perfect Playwright comparison. Depends on //:lib (the components) + the
# registry closure (//:registry.bzl, shared with check/ — 73.2.0). SEPARATE
# package so the root //:lib straylight-web consumes stays free of `packages`.
#   nix develop -c buck2 build //examples:gallery   ->  dist (app.js + index.html + style.css)
load("//:registry.bzl", "PURS_REGISTRY")

purescript_app(
    name = "gallery",
    srcs = [
        "src/Gallery/Main.purs",
        "src/Gallery/Story.purs",
        "src/Gallery/Story/AlertDialog.purs",
        "src/Gallery/Story/Checkbox.purs",
        "src/Gallery/Story/Collapsible.purs",
        "src/Gallery/Story/ContextMenu.purs",
        "src/Gallery/Story/Dialog.purs",
        "src/Gallery/Story/DropdownMenu.purs",
        "src/Gallery/Story/HoverCard.purs",
        "src/Gallery/Story/Label.purs",
        "src/Gallery/Story/Popover.purs",
        "src/Gallery/Story/Select.purs",
        "src/Gallery/Story/Tooltip.purs",
        "src/Gallery/Story/Separator.purs",
        "src/Gallery/Story/Switch.purs",
        "src/Gallery/Story/Toggle.purs",
        "src/Gallery/Story/TogglePresets.purs",
        "src/Gallery/Story/Presets.purs",
        "src/Gallery/Story/InvA.purs",
        "src/Gallery/Story/InvB.purs",
        "src/Gallery/Story/InvC.purs",
