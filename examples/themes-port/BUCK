# Hydrogen.Themes port — the Halogen reproduction of Radix Themes, bundled to a
# browser app and pixel-diffed (testing/playwright) against the golden source in
# testing/golden/themes. Shares the golden's route contract (?c=<id>) and its
# compiled stylesheet (themes.css = radix-ui/themes styles.css + bundled Inter),
# so a passing diff proves our DOM + rt-* classes equal upstream's.
#   nix develop -c buck2 build //examples/themes-port:app
load("//:registry.bzl", "PURS_REGISTRY")

purescript_app(
    name = "app",
    srcs = [
        "src/ThemesPort/Main.purs",
    ],
    main = "ThemesPort.Main",
    deps = ["//:lib"],
    index_html = "index.html",
    style_css = "themes.css",
    packages = PURS_REGISTRY,
)
